# 移动端后端在服务器上的环境变量
#
# 安装：复制为 /srv/edu-platform/api/.env 后按实际修改。
#       systemd 通过 EnvironmentFile 读取（见 keban-api.service）。
#
# 注意：数据库、大模型、SMTP 这些**不在这里配**——api 启动时会自动读
#      ../.streamlit/secrets.toml（同一份配置，网页版和移动端共用）。
#      只有下面这些「移动端独有」的项才放这里。

# 独立于 AUTH_OTP_SECRET 的登录凭证签名密钥。
# 不设会自动回落到 AUTH_OTP_SECRET，能跑；但建议显式设置——
# 这样以后轮换 OTP 密钥时不会把所有已登录用户踢下线。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
API_JWT_SECRET=

# 登录有效期（小时），默认 168 = 7 天
API_TOKEN_TTL_HOURS=168

# 允许的跨域来源，逗号分隔。
# 小程序不走 CORS；这里主要是给 H5 用——H5 从哪个地址打开就写哪个。
# 只走 nginx 同源（H5 在 /h5/、API 在 /api/，同一个域名）时其实用不上；
# 真机联调直连 8000 端口时才需要放开。
# API_CORS_ORIGINS=http://your-server-ip
