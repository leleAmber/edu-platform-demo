NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DB_FILE=./data/keban.sqlite
SESSION_DAYS=7
COOKIE_SECURE=false

# 首次启动时创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_admin_123!

# 邮件：配置后发送真实验证码；未配置时开发环境会在接口响应和终端显示验证码
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="课伴AI <no-reply@example.com>"
ALLOW_DEV_EMAIL_CODE=true

# 支付：配置 Stripe 后创建真实 Checkout Session；未配置时只能使用本地测试支付
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/?payment=cancelled
